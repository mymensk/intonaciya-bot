# Telegram: токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# LLM-шлюз с API в формате OpenAI.
# Если задан, используется вместо прямого доступа к GigaChat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gigachat3.5-432b-a28b

# Прямой доступ к GigaChat API: Authorization Key из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Корневой сертификат НУЦ Минцифры, без него TLS к GigaChat не проходит
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem
