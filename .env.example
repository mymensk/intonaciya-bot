# Telegram: токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Доступ: Telegram ID через запятую или * для всех. Пусто — бот закрыт и только сообщает ID
ALLOWED_USER_IDS=
# Telegram ID для служебных уведомлений (например, о расходе бюджета LLM)
ADMIN_USER_ID=
# Аккаунты команды и тестировщиков через запятую: без дневного лимита, не входят в метрики.
# Администратор считается тестовым всегда
TEST_USER_IDS=
# Сколько запросов к модели (разборов и скриншотов) можно сделать за день
DAILY_LLM_LIMIT=30
# Контакт оператора для политики конфиденциальности (email или @username)
SUPPORT_CONTACT=

# Метрики использования (SQLite). Telegram ID хранятся в виде HMAC с этим секретом.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))". Не менять после запуска
METRICS_SALT=
METRICS_DB_PATH=data/metrics.sqlite3

# LLM-шлюз с API в формате OpenAI.
# Если задан, используется вместо прямого доступа к GigaChat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gigachat3.5-432b-a28b
# Модель для распознавания скриншотов через шлюз; пусто — только локальный Tesseract
VISION_MODEL=qwen3-vl-8b-instruct

# Прямой доступ к GigaChat API: Authorization Key из личного кабинета developers.sber.ru.
# Без ключей бот работает в тестовом режиме и показывает, что получила бы модель
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Корневой сертификат НУЦ Минцифры, без него TLS к GigaChat не проходит
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem
